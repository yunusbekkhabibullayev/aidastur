# ========================================================
# AI FACT CHECKER - ENVIRONMENT CONFIGURATION
# ========================================================

# Google Gemini API Key (Google AI Studio or Vertex AI)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional Search API Keys (if using dedicated search providers; DuckDuckGo works with no key)
SERPER_API_KEY=
TAVILY_API_KEY=

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=true
ENVIRONMENT=development

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Pipeline Settings
MAX_CLAIMS_PER_INPUT=5
MAX_SEARCH_RESULTS_PER_CLAIM=8
SEARCH_TIMEOUT_SECONDS=10

